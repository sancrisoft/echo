# macOS
.DS_Store

# Xcode — user-specific state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Xcode — build output
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
# (Package.resolved is kept in xcshareddata so dependency versions are pinned)
.build/
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata

# Accidentally generated
*.swp

# local models
.local-models

# Working docs (specs, ADRs, brainstorms) — local-only, never in the repo.
.conduct/

# Test fixtures — real recorded audio, local-only (never shipped in the repo).
# Test sources ARE tracked as of 2026-07-13; only fixtures and generated
# reports stay local.
/Fixtures/
EchoTests/sp002-measure-report.txt
/meetings_sample/

# Design canvas working files (artboards) — local-only.
.design/

# Agent skills. The third-party set is declared in skills-lock.json and
# restored with `npx skills experimental_install`, never vendored here: it is
# other authors' work and it would drag their licences into NOTICE. Echo's own
# skills under .claude/skills/echo-* are tracked; everything else installed
# there is a symlink into .agents/ and is not.
.agents/
.claude/skills/*
!.claude/skills/echo-*
