# macOS
.DS_Store

# Xcode — user-specific state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Xcode — build output
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
# (Package.resolved is kept in xcshareddata so dependency versions are pinned)
.build/
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata

# Accidentally generated
*.swp

# local models
.local-models

# Working docs (specs, ADRs, brainstorms) — local-only, never in the repo.
.conduct/

# Test fixtures — real recorded audio and real meeting transcripts, local-only
# (never in the repo). Test sources are tracked; only fixtures, samples and
# generated reports stay local.
/Fixtures/*
!/Fixtures/README.md
/meetings_sample/
/EchoTests/

# Downloaded third-party agent skills (restored from a lock file, never vendored).
.agents/skills/
.claude/skills/
